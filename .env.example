# Public site URL (used for canonical URL, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Which media retrieval provider to use: "none" | "instagram_graph" | "custom" | "yt_dlp"
#   yt_dlp          -> yt-dlp CLI (bundled automatically on Vercel builds; temporary option)
#   none            -> the app returns PROVIDER_NOT_CONFIGURED (honest default)
#   instagram_graph -> official Instagram API; only works for Reels owned by the
#                      account whose token you configure (your own Reels)
#   custom          -> a third-party media provider whose terms explicitly permit this use
MEDIA_PROVIDER=yt_dlp

# --- instagram_graph provider (official Instagram API with Instagram Login) ---
# Long-lived access token with instagram_business_basic permission for YOUR
# professional (Business/Creator) account. Never commit the real value.
INSTAGRAM_ACCESS_TOKEN=
# Graph API version and how many pages (25 items each) of your media to scan.
INSTAGRAM_GRAPH_VERSION=v21.0
INSTAGRAM_MAX_PAGES=8

# --- custom provider (licensed / authorized third-party API) ---
# The app POSTs {"url": "<reel url>"} with header "Authorization: Bearer <key>"
# and expects JSON {"title"?, "thumbnail"?, "videoUrl"} or {"error": {"code": ...}}.
CUSTOM_PROVIDER_ENDPOINT=
CUSTOM_PROVIDER_API_KEY=

# Extra media hostnames allowed for download (comma separated, exact host or
# ".suffix"). Instagram/Facebook CDNs are always allowed.
MEDIA_ALLOWED_HOSTS=

# Basic per-instance rate limit (requests per minute per client).
RATE_LIMIT_PER_MINUTE=20

# --- yt_dlp provider --- optional binary path (leave empty: bundled/installed one is used)
YTDLP_PATH=
